# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/women_safety_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/women_safety_db?retryWrites=true&w=majority

# Security & Secrets
JWT_SECRET=your_jwt_secret_key_here
ADMIN_PASSCODE=YOUR_ADMIN_PASSCODE_HERE

# AI Microservice URL
AI_SERVICE_URL=http://localhost:5001

# Storage
UPLOAD_PATH=./uploads
